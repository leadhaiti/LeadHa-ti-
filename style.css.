* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #17243b;
}

header {
    background: #102443;
    color: white;
    padding: 25px 20px;
    text-align: center;
}

header h1 {
    color: #d4af37;
    font-size: 27px;
}

header p {
    margin-top: 8px;
    font-size: 14px;
}

.container {
    padding: 20px;
    padding-bottom: 100px;
}

.welcome {
    background: #ffffff;
    padding: 22px;
    border-radius: 15px;
    margin-bottom: 20px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.06);
}

.welcome h2 {
    color: #102443;
    margin-bottom: 10px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 15px;
    margin-bottom: 15px;
    border-left: 4px solid #d4af37;
    box-shadow: 0 3px 12px rgba(0,0,0,0.05);
}

.card h3 {
    margin-bottom: 8px;
    color: #102443;
}

button {
    background: #102443;
    color: white;
    border: none;
    padding: 13px 20px;
    border-radius: 10px;
    font-size: 15px;
    cursor: pointer;
}

button:hover {
    background: #d4af37;
    color: #102443;
}

.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: white;
    display: flex;
    justify-content: space-around;
    padding: 13px 5px;
    box-shadow: 0 -3px 15px rgba(0,0,0,0.1);
    border-top: 2px solid #d4af37;
}

.bottom-nav a {
    text-decoration: none;
    color: #102443;
    font-size: 12px;
    text-align: center;
}

.bottom-nav a.active {
    color: #c49b25;
    font-weight: bold;
}

.bottom-nav span {
    display: block;
    font-size: 20px;
    margin-bottom: 4px;
}
